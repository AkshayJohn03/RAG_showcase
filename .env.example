LLM_PROVIDER=none
# LLM_PROVIDER=ollama      # real grounded generation (needs `ollama pull qwen3:1.7b`)
# OLLAMA_MODEL=qwen3:1.7b  # reasoning disabled + token cap in code: quality without minutes of <think>
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

VECTOR_BACKEND=local
# VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_showcase

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_STRATEGY=parent_child
CHUNK_SIZE=512
CHUNK_OVERLAP=80
HYBRID_ALPHA=0.5
RERANK_TOP_N=5
# RERANKER=auto  (auto | heuristic | cross-encoder — set heuristic on slow networks to skip the model probe)

# --- verification (Langfuse traces; unset = local eval-gate only, still fully working) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# PREWARM_SAMPLES=1  (answer the 3 demo questions at boot so clicks are instant)

# --- enterprise edge ---
# API_KEY=change-me-in-prod   (unset = open mode, dev only; clients send X-API-Key)
# RATE_LIMIT_PER_MIN=30
API_PORT=8000
